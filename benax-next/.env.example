# Postgres connection (Neon, Supabase, RDS, local — any Postgres works)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Auth.js v5
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Seed admin credentials (used by `npm run db:seed`)
ADMIN_EMAIL="admin@benax.local"
ADMIN_PASSWORD="change-me-on-seed"
ADMIN_NAME="BENAX Admin"
